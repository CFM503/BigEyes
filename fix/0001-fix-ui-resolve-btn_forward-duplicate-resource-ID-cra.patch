 CHANGELOG.md                                           | 10 ++++++++++
 README.md                                              |  3 ++-
 bigeyes-app/app/build.gradle.kts                       |  4 ++--
 .../app/src/main/java/com/bigeyes/app/MainActivity.kt  |  2 +-
 bigeyes-app/app/src/main/res/layout/activity_main.xml  |  2 +-
 5 files changed, 16 insertions(+), 5 deletions(-)

