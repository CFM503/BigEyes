<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        app:title="设置与调试 (v2 纯手机版)"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Battery Optimization Whitelist Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="锁屏与后台保活保障"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BigEyes 作为手机本地流媒体代理服务器，投屏期间需保持 CPU 与 WiFi 高性能运行。建议开启后台无限制白名单以防电视断流。"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <Button
                        android:id="@+id/btn_ignore_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="申请忽略电池优化 (防锁屏断流)"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/brand_secondary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Local Proxy Server Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手机本地内嵌 HTTP 服务"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_local_server_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本机局域网 IP: 获取中...\n内嵌代理端口: 8765\n预取并发: 2~3 (手机专属调优)"
                        android:textColor="#444444"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tv_cache_info"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="缓存占用: 0 MB / 300 MB"
                            android:textSize="13sp"
                            android:textColor="#555555" />

                        <Button
                            android:id="@+id/btn_clear_cache"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="清理分片缓存"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sniff Debug Logs Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="嗅探抓包调试记录"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/black" />

                        <Button
                            android:id="@+id/btn_clear_logs"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="清空"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_debug_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:typeface="monospace"
                        android:background="#EFEFEF"
                        android:padding="8dp"
                        android:layout_marginTop="8dp"
                        android:textColor="#333333"
                        android:text="暂无抓包记录。在浏览器中播放视频后，此处将展示原始嗅探 URL 及 Headers 上下文。" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
