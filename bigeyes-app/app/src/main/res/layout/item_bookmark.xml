<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:background="@drawable/bg_option">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/iv_bookmark_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_bookmark_filled"
            app:tint="@color/brand_primary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_bookmark_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tv_bookmark_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="腾讯视频" />

        <TextView
            android:id="@+id/tv_bookmark_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="https://v.qq.com"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_set_as_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_home"
        app:tint="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="设为默认主页" />

    <ImageButton
        android:id="@+id/btn_edit_bookmark"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_edit"
        app:tint="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="编辑书签" />

    <ImageButton
        android:id="@+id/btn_delete_bookmark"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_delete"
        app:tint="@color/danger"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="删除书签" />

</LinearLayout>
