<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="14dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iv_bookmark_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_bookmark_filled"
        app:tint="@color/brand_primary"
        android:contentDescription="书签图标"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:id="@+id/layout_bookmark_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_bookmark_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="腾讯视频" />

        <TextView
            android:id="@+id/tv_bookmark_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="https://v.qq.com"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_set_as_home"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_home"
        app:tint="#666666"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="设为默认主页"
        android:layout_marginStart="4dp" />

    <ImageButton
        android:id="@+id/btn_edit_bookmark"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_edit"
        app:tint="#666666"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="编辑书签"
        android:layout_marginStart="4dp" />

    <ImageButton
        android:id="@+id/btn_delete_bookmark"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_delete"
        app:tint="#E53935"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="删除书签"
        android:layout_marginStart="4dp" />

</LinearLayout>
