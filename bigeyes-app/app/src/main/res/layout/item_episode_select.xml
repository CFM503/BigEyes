<?xml version="1.0" encoding="utf-8"?>
<!-- Episode tile in the 选集 grid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_episode_container"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_episode_tile"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/tv_item_episode_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/tv_item_episode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="第 1 集"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_item_playing_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_badge_pill"
        android:paddingHorizontal="5dp"
        android:text="播放中"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
