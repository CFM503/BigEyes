<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/control_bar_bg"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"
    android:elevation="8dp">

    <!-- Title and Device Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_playing_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="正在电视投屏播放..." />

        <TextView
            android:id="@+id/tv_queue_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="第 1 集"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tv_target_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:maxWidth="100dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="电视"
            android:layout_marginStart="8dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_close_control"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:padding="8dp"
            android:contentDescription="关闭播控" />
    </LinearLayout>

    <!-- Progress SeekBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:text="00:00:00" />

        <SeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:thumbTint="@color/brand_primary"
            android:progressTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tv_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:text="00:00:00" />
    </LinearLayout>

    <!-- Primary Transport Row (fits cleanly on 360dp phones without overflow) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btn_previous_episode"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="44dp"
            android:paddingHorizontal="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="上集"
            android:textSize="12sp"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_rewind"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="44dp"
            android:paddingHorizontal="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="-15s"
            android:textSize="12sp"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="64dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="暂停"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="6dp"
            android:backgroundTint="@color/brand_primary"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_forward"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="44dp"
            android:paddingHorizontal="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+15s"
            android:textSize="12sp"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_next_episode"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="44dp"
            android:paddingHorizontal="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="下集"
            android:textSize="12sp"
            android:textColor="@color/brand_primary" />
    </LinearLayout>

    <!-- Secondary Actions Row: Speed, Device Switch, Episode List, Stop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <Button
            android:id="@+id/btn_speed"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="1.0x"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/btn_switch_device"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="换设备"
            android:textSize="12sp"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_select_episode"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="选集"
            android:textSize="12sp"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_stop"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="停止"
            android:textSize="12sp"
            android:textColor="#FF5252" />
    </LinearLayout>

</LinearLayout>
