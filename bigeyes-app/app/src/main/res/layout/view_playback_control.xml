<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/control_bar_bg"
    android:padding="12dp"
    android:elevation="8dp">

    <!-- Title and Device Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_playing_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="正在电视投屏播放..." />

        <TextView
            android:id="@+id/tv_target_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:text="客厅电视"
            android:layout_marginStart="8dp" />

        <ImageButton
            android:id="@+id/btn_close_control"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_muted"
            android:contentDescription="关闭播控" />
    </LinearLayout>

    <!-- Progress SeekBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:text="00:00:00" />

        <SeekBar
            android:id="@+id/seekbar_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:thumbTint="@color/brand_primary"
            android:progressTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tv_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:text="00:00:00" />
    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btn_rewind"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="-15s"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="暂停"
            android:textSize="14sp"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/brand_primary"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_forward"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+15s"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="停止"
            android:textSize="12sp"
            android:layout_marginStart="8dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#FF5252" />
    </LinearLayout>

</LinearLayout>
