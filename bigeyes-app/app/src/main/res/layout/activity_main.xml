<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <!-- Top Browser Bar: rounded URL pill (with refresh) + cast button -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_top_bar"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_url_input">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                app:srcCompat="@drawable/ic_globe"
                app:tint="@color/text_muted"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/et_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:hint="输入网址或搜索..."
                android:textSize="13sp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="text" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_clear_url"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_close"
                app:tint="@color/text_muted"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="清空地址栏" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_refresh"
                app:tint="@color/icon_secondary"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="刷新" />
        </LinearLayout>

        <!-- Cast Button with Candidate Count Badge -->
        <FrameLayout
            android:id="@+id/layout_cast_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cast"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="投屏"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/brand_primary"
                app:cornerRadius="@dimen/radius_control"
                app:icon="@drawable/ic_cast"
                app:iconSize="18dp"
                app:iconPadding="6dp"
                app:iconTint="@color/white"
                app:elevation="0dp" />

            <TextView
                android:id="@+id/tv_badge_count"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:minWidth="20dp"
                android:paddingHorizontal="5dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-6dp"
                android:background="@drawable/bg_badge_circle"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                android:text="1" />
        </FrameLayout>
    </LinearLayout>

    <!-- Page Load Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressDrawable="@drawable/progress_bar_drawable"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- Main WebView Container -->
    <FrameLayout
        android:id="@+id/web_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintBottom_toTopOf="@id/container_playback_control">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Dims the page while the playback panel is expanded; tap to collapse it. -->
    <View
        android:id="@+id/view_control_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_control_scrim"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="收起播控面板"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/container_playback_control" />

    <!-- Bottom Playback Control Container (Visible when active casting) -->
    <FrameLayout
        android:id="@+id/container_playback_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <include layout="@layout/view_playback_control" />
    </FrameLayout>

    <!-- Bottom Browser Navigation Bar: icon + label -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_nav_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingBottom="16dp"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/icon_secondary"
                android:contentDescription="后退" />

            <!-- Label is not clickable: taps fall through to the button underneath. -->
            <TextView
                android:id="@+id/tv_nav_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="后退" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_nav_forward"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingBottom="16dp"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_arrow_forward"
                app:tint="@color/icon_secondary"
                android:contentDescription="前进" />

            <!-- Label is not clickable: taps fall through to the button underneath. -->
            <TextView
                android:id="@+id/tv_nav_forward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="前进" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingBottom="16dp"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/icon_secondary"
                android:contentDescription="主页" />

            <!-- Label is not clickable: taps fall through to the button underneath. -->
            <TextView
                android:id="@+id/tv_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="主页" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_bookmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingBottom="16dp"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_bookmark"
                app:tint="@color/icon_secondary"
                android:contentDescription="书签收藏" />

            <!-- Label is not clickable: taps fall through to the button underneath. -->
            <TextView
                android:id="@+id/tv_nav_bookmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="书签" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingBottom="16dp"
                android:scaleType="center"
                app:srcCompat="@drawable/ic_settings"
                app:tint="@color/icon_secondary"
                android:contentDescription="设置" />

            <!-- Label is not clickable: taps fall through to the button underneath. -->
            <TextView
                android:id="@+id/tv_nav_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="设置" />
        </FrameLayout>
    </LinearLayout>

    <!-- Next Episode Countdown Overlay -->
    <FrameLayout
        android:id="@+id/container_next_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/view_next_episode_countdown" />
    </FrameLayout>

    <!-- Fullscreen Custom View Container for HTML5 Video -->
    <FrameLayout
        android:id="@+id/fullscreen_custom_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
